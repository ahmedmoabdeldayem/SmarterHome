[Unit]
Description=SmarterHome AWS IoT Bridge
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/SmarterHome/hub/bridge
ExecStart=/home/pi/SmarterHome/hub/bridge/build/smarthome_bridge
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
