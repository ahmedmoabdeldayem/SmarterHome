#define MQTT_BROKER    "192.168.1.100"   // Raspberry Pi local IP
// MQTT_USER is intentionally absent: each node uses its MQTT_CLIENT_ID as the
// username so that the per-node ACL entries in mosquitto_acl apply correctly.
// Create one Mosquitto account per node (all share the same password):
//   sudo mosquitto_passwd /etc/mosquitto/passwd esp32-living-room
//   sudo mosquitto_passwd /etc/mosquitto/passwd esp32-bedroom
//   sudo mosquitto_passwd /etc/mosquitto/passwd esp32-kitchen
//   sudo mosquitto_passwd /etc/mosquitto/passwd esp32-entrance
#define MQTT_PASSWORD  "YOUR_MQTT_PASSWORD"

// Mains voltage at your location (220 for most of the world, 110 for North America)
#define MAINS_VOLTAGE  220.0f
